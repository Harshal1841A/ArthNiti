# ArthNiti — Python backend environment variables template.
# Copy to .env and fill in real values. Never commit .env.

# API Authentication Key for programmatic access — REQUIRED, not optional.
# Must match VITE_API_KEY below exactly. If DEMO_MODE=true and this is left
# blank, the server now refuses to start at all (see backend/main.py) rather
# than silently accepting unauthenticated writes — a prior version of this
# comment called this "optional for same-origin SPA calls," which described
# a same-origin bypass mechanism that has since been removed for being
# trivially spoofable. That old comment is why this line has been found
# blank in real deployments. Set it.
ARTHNITI_API_KEY=

# Must match ARTHNITI_API_KEY above exactly — this is what the frontend
# bundle sends as the Bearer token.
VITE_API_KEY=

# Database (defaults to local SQLite — fine for hackathon)
# For production: use PostgreSQL and set RLS policies
DATABASE_URL=sqlite+aiosqlite:///./data/arthniti.db

# AA sandbox — Finvu developer sandbox
FINVU_SANDBOX_BASE=https://sandbox.finvu.in
# FIU private key (ECDH P-256 JWK format). Generate with:
#   python scripts/generate_fiu_keys.py
# Register the public key with Finvu sandbox before calling /data/fetch.
FIU_PRIVATE_KEY_JWK=

# LLM — primary: NVIDIA Nemotron Ultra (NVIDIA Integrate API)
# https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# LLM — fallback: Google Gemma 4 31B (NVIDIA Integrate API)
# Note: This is NOT failover-redundant against an NVIDIA outage, just model-tier fallback.
NVIDIA_FALLBACK_API_KEY=
NVIDIA_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FALLBACK_MODEL=google/gemma-4-31b-it

# Bhashini TTS (F8 Tier 1) — optional, access unconfirmed.
# Obtain at bhashini.gov.in. If absent, F8 uses IndicTTS then browser fallback.
BHASHINI_API_KEY=

# Model path (relative to repo root)
MODEL_PATH=./models/xgb_model.json

# Scoring thresholds
USABLE_SCORE_THRESHOLD=0.30
MIN_DATA_COMPLETENESS=0.20

# CORS — set to your frontend URL in production
FRONTEND_URL=http://localhost:5173
